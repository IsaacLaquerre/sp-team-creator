{
  "name": "sp-team-creator",
  "version": "1.0.9-alpha",
  "description": "Équipe de projet",
  "main": "main.js",
  "author": "Isaac",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win",
    "release": "electron-builder --win --publish always"
  },
  "dependencies": {
    "electron-updater": "^6.3.9"
  },
  "devDependencies": {
    "electron": "^45.2.3",
    "electron-builder": "^26.18.0"
  },
  "build": {
    "appId": "com.consstellaire.sp-team-creator",
    "productName": "Équipe de projet",
    "files": [
      "main.js",
      "preload.js",
      "index.html",
      "renderer.js",
      "package.json",
      "lib/**/*",
      "assets/**/*"
    ],
    "icon": "assets/icon.ico",
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "assets/icon.ico"
    },
    "electronFuses": {
      "runAsNode": false,
      "enableNodeOptionsEnvironmentVariable": false,
      "enableNodeCliInspectArguments": false,
      "enableEmbeddedAsarIntegrityValidation": true,
      "onlyLoadAppFromAsar": true,
      "enableCookieEncryption": true
    },
    "publish": {
      "provider": "github",
      "owner": "IsaacLaquerre",
      "repo": "sp-team-creator",
      "private": false,
      "releaseType": "prerelease"
    }
  }
}
