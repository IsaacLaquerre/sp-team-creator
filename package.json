{
  "name": "sp-team-creator",
  "version": "1.0.8-alpha",
  "description": "Équipe de projet",
  "main": "main.js",
  "author": "Isaac",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win",
    "release": "electron-builder --win --publish always"
  },
  "dependencies": {
    "electron-updater": "^6.3.9"
  },
  "devDependencies": {
    "electron": "^33.0.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "com.consstellaire.sp-team-creator",
    "productName": "Équipe de projet",
    "files": ["main.js", "preload.js", "index.html", "package.json", "lib/**/*", "assets/**/*"],
    "icon": "assets/icon.ico",
    "win": { "target": ["nsis"], "icon": "assets/icon.ico" },
    "publish": {
      "provider": "github",
      "owner": "IsaacLaquerre",
      "repo": "sp-team-creator",
      "private": true,
      "releaseType": "prerelease"
    }
  }
}
